rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return signedIn()
        && (('role' in request.auth.token)
          ? request.auth.token.role == role
          : false);
    }

    function isAdmin() {
      return signedIn()
        && ((('admin' in request.auth.token)
            ? request.auth.token.admin == true
            : false)
          || hasRole('admin'));
    }

    function isCollector() {
      return signedIn()
        && ((('collector' in request.auth.token)
            ? request.auth.token.collector == true
            : false)
          || hasRole('collector'));
    }

    function ownsExistingCustomerRecord() {
      return resource.data.customerId == request.auth.uid;
    }

    function ownsNewCustomerRecord() {
      return request.resource.data.customerId == request.auth.uid;
    }

    function assignedExistingCollectorRecord() {
      return isCollector() && resource.data.collectorId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'customer';
      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active);
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow create: if isOwner(customerId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.get('role', 'customer') == 'customer'
        && request.resource.data.keys().hasOnly([
          'uid',
          'userId',
          'phoneNumber',
          'phone',
          'email',
          'displayName',
          'fullName',
          'name',
          'avatarUrl',
          'profileImage',
          'onboardingCompleted',
          'accountStatus',
          'authProviders',
          'serviceArea',
          'serviceZone',
          'createdAt',
          'updatedAt'
        ]);
      allow update: if isAdmin()
        || (isOwner(customerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'uid',
            'userId',
            'phoneNumber',
            'phone',
            'email',
            'displayName',
            'fullName',
            'name',
            'avatarUrl',
            'profileImage',
            'onboardingCompleted',
            'accountStatus',
            'authProviders',
            'serviceArea',
            'serviceZone',
            'updatedAt'
          ])
          && request.resource.data.get('uid', request.auth.uid) == request.auth.uid
          && request.resource.data.get('userId', request.auth.uid) == request.auth.uid
          && request.resource.data.get('accountStatus', 'active')
            == resource.data.get('accountStatus', 'active')
          && request.resource.data.get('role', 'customer')
            == resource.data.get('role', 'customer'));
      allow delete: if isAdmin();
    }

    match /collectors/{collectorId} {
      allow read: if isOwner(collectorId) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isOwner(collectorId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.active == resource.data.active
          && request.resource.data.payRate == resource.data.payRate);
    }

    match /addresses/{addressId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid;
      allow read, delete: if isAdmin() || ownsExistingCustomerRecord();
      allow update: if isAdmin()
        || (ownsExistingCustomerRecord()
          && request.resource.data.customerId == resource.data.customerId);
    }

    match /serviceZones/{zoneId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || ownsExistingCustomerRecord();
      allow create: if isAdmin()
        || (ownsNewCustomerRecord() && request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    match /pickups/{pickupId} {
      allow create: if ownsNewCustomerRecord()
        && request.resource.data.status == 'scheduled'
        && request.resource.data.collectorId == null;
      allow read: if isAdmin()
        || ownsExistingCustomerRecord()
        || assignedExistingCollectorRecord();
      allow update: if isAdmin()
        || (assignedExistingCollectorRecord()
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.collectorId == resource.data.collectorId
          && request.resource.data.status in ['en_route', 'arrived', 'completed', 'missed', 'rescheduled']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'completionNotes',
            'proofPath',
            'completedAt',
            'rescheduledAt',
            'scheduledDate',
            'updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    // Temporary compatibility path until Day 4 migrates the client to pickups.
    match /bookings/{bookingId} {
      allow create: if ownsNewCustomerRecord();
      allow read: if isAdmin()
        || ownsExistingCustomerRecord()
        || assignedExistingCollectorRecord();
      allow update: if isAdmin()
        || ownsExistingCustomerRecord()
        || assignedExistingCollectorRecord();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || ownsExistingCustomerRecord();
      allow create: if ownsNewCustomerRecord()
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /collectorDailyStats/{statId} {
      allow read: if isAdmin()
        || (isCollector() && resource.data.collectorId == request.auth.uid);
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if false;
    }

    match /deviceTokens/{tokenId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if signedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
