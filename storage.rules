rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (('admin' in request.auth.token && request.auth.token.admin == true)
          || ('role' in request.auth.token && request.auth.token.role == 'admin'));
    }

    function validImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn()
        && (request.auth.uid == userId || isAdmin())
        && validImage();
    }

    match /pickupProof/{customerId}/{collectorId}/{pickupId}/{fileName} {
      allow read: if signedIn()
        && (request.auth.uid == customerId
          || request.auth.uid == collectorId
          || isAdmin());
      allow write: if signedIn()
        && (request.auth.uid == collectorId || isAdmin())
        && validImage();
    }

    match /paymentReceipts/{customerId}/{paymentId}/{fileName} {
      allow read: if signedIn()
        && (request.auth.uid == customerId || isAdmin());
      allow write: if signedIn()
        && request.auth.uid == customerId
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf');
    }

    match /collection-quotes/{userId}/{bookingId}/{fileName} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && bookingId.matches('collection_[0-9a-f]{64}')
        && fileName.matches('quote_[1-4]_[0-9a-f]{16}\\.(jpg|png|webp)')
        && request.resource.size <= 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /profileImages/{userId}/{fileName} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.size <= 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
