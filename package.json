{
  "name": "cleango-workspace",
  "private": true,
  "scripts": {
    "test:scheduling": "vitest run tests/scheduling.test.ts",
    "test:rules": "firebase emulators:exec --only firestore,storage \"vitest run tests/security-rules.test.ts\"",
    "test:collection-rules": "firebase emulators:exec --only firestore \"vitest run tests/collection-booking-rules.test.ts --pool=forks --maxWorkers=1 --testTimeout=30000\"",
    "test:operational-rules": "firebase emulators:exec --only firestore \"vitest run tests/operational-rules.test.ts --pool=forks --maxWorkers=1 --testTimeout=30000\"",
    "test:customer-rules": "firebase emulators:exec --only firestore \"vitest run tests/customer-provisioning-rules.test.ts --pool=forks --maxWorkers=1 --testTimeout=30000\"",
    "test:collection-storage-rules": "firebase emulators:exec --only storage \"vitest run tests/collection-booking-storage-rules.test.ts --pool=forks --maxWorkers=1\"",
    "test:booking-rules": "npm run test:collection-rules && npm run test:collection-storage-rules",
    "test:launch": "vitest run tests/launch-readiness.test.ts",
    "test:day12": "npm run test:scheduling && npm run test:launch"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.9.1",
    "firebase-tools": "^14.6.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
