# CLEANGO staging backend environment example
# Copy these variable names into the staging Render service only.
# Do not paste production values here. Do not commit real credentials.

# Required runtime configuration
NODE_ENV=staging
PORT=3000
MONGODB_URI=mongodb+srv://<staging-user>:<staging-password>@<cluster>.mongodb.net/cleango_staging
JWT_SECRET=<generate-a-long-random-staging-only-secret>
JWT_ACCESS_EXPIRES_IN=1h
JWT_SECRET_EXPIRES_IN=24h
REFRESH_TOKEN_TTL_DAYS=30
ALLOWED_ORIGINS=https://<staging-admin-or-web-domain>

# Optional integrations: leave blank or disable in admin settings until staging credentials exist.
# Stripe must use test mode keys only.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PAYMENT_CALLBACK_SECRET=

# SMS should use a Twilio test/sandbox number where possible.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email should use a staging sender/domain, not production sender identity.
SMTP_HOST=
SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
EMAIL_FROM=staging@example.com

# Image uploads can remain disabled until needed.
IMGBB_API_KEY=

# Firebase Admin is optional for minimum REST staging.
# Use a separate Firebase staging project when enabling Firebase-backed CLEANGO features.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
